# ---- Server (Render) ----
NODE_ENV=production
PORT=10000
CLIENT_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# ---- Auth ----
JWT_SECRET=use-a-long-random-production-secret

# ---- PostgreSQL (Render auto-provides DATABASE_URL) ----
# DATABASE_URL=postgres://user:password@host:5432/database

# ---- OAuth (production credentials) ----
# Callback URLs registered with each provider must exactly match:
#   ${BACKEND_URL}/api/auth/google/callback
#   ${BACKEND_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- SMTP for password-reset OTP emails (required in production) ----
# If unset, OTP emails silently fall back to a disposable Ethereal test inbox
# and never reach real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Victor.io Solutions <no-reply@victorio.solutions>
